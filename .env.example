# GlobalPath Kaseddie Agent — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit real credentials here. This file is public.

# ── LLM Providers ──────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
VITE_APP_GEMINI_API_KEY=your_gemini_api_key_here

# ── Qdrant Vector Database ──────────────────────────────────────────────────
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_jwt_token_here

# ── MongoDB Atlas (Sentinel-Memory-Vault) ───────────────────────────────────
# Replace <username>, <password>, and <cluster-host> with your actual values
MDB_URI="mongodb://<username>:<password>@<cluster-host>/?ssl=true&replicaSet=atlas-xxx-shard-0&authSource=admin&retryWrites=true&w=majority&appName=Sentinel-Memory-Vault"

# ── HuggingFace Embeddings ──────────────────────────────────────────────────
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here

# ── Authentication ──────────────────────────────────────────────────────────
# Must be a long random string (min 32 chars). App will refuse to start without this.
JWT_SECRET=your_very_long_random_jwt_secret_here

# Admin dashboard password (used by POST /api/admin/login)
VITE_ADMIN_PASSWORD=your_admin_password_here

# Replit OIDC (only needed when deployed on Replit)
REPL_ID=your_repl_id_here
ISSUER_URL=https://replit.com/oidc
SESSION_SECRET=your_session_secret_here

# ── Apify Lead Ingestion ────────────────────────────────────────────────────
# ==========================================
# APIFY AUTHENTICATION & SECURE TOKENS
# ==========================================
APIFY_API_TOKEN=your_apify_token_here

# ==========================================
# ACTIVE GLOBALPATH DATASET REGISTRY
# ==========================================
# Dubai: House Maid, Nanny, Cleaner
VITE_APIFY_DATASET_DUBAI_DOMESTIC=g9Pg0BU11XzFwnz7F

# Dubai: Supermarket Jobs
VITE_APIFY_DATASET_DUBAI_SUPERMARKET=4tnScCDh9uwequnxM

# Canada: Drivers & Logistics
VITE_APIFY_DATASET_CANADA_DRIVERS=ms313L8RKc6eLBydO

# Enable the Apify background sync daemon (pulls live items from the registry)
ENABLE_APIFY_SYNC=true

# ── GitLab Integration ──────────────────────────────────────────────────────
GITLAB_TOKEN=your_gitlab_personal_access_token_here
GITLAB_PROJECT_ID=your_gitlab_project_id_here

# ── Media Generation ────────────────────────────────────────────────────────
VITE_FAL_KEY=your_fal_ai_key_here
FAL_KEY=your_fal_ai_key_here
VITE_REPLICATE_API_TOKEN=your_replicate_api_token_here
REPLICATE_API_TOKEN=your_replicate_api_token_here

# ── GCP / Vertex AI (optional — only needed for cloud deployment) ───────────
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here

# ── Server Configuration ────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
ENV=development

# ── Stripe Micro-Transaction (Featured Agency Spotlight) ─────────────────────
# Test keys: sk_test_.../whsec_... — Live: sk_live_... (server uses STRIPE_SECRET_KEY only)
# Get them from dashboard.stripe.com (API keys / Webhooks). For local webhook
# testing: stripe listen --forward-to localhost:10000/api/stripe/webhook
STRIPE_SECRET_KEY=your_stripe_secret_key_here
# Webhook signing secret (whsec_...) — REQUIRED for the /api/stripe/webhook receiver
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
# Base URL for the Stripe success/cancel redirects (no trailing slash)
FRONTEND_URL=https://globalpathkaseddieagent.com

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5000,https://your-render-domain.onrender.com

# ── Sentinel Audit Settings ─────────────────────────────────────────────────
AUDIT_LOG_LEVEL=DEBUG
CORRIDOR_FOCUS=Uganda-GCC-Europe

# ── DigitalOcean AI (legacy fallback — optional) ────────────────────────────
VITE_DO_AGENT_ENDPOINT=your_do_agent_endpoint_here
VITE_DO_AGENT_ACCESS_KEY=your_do_access_key_here
